---
import { SITE_CONFIG } from '../config';

const navLinks = [
  { label: '首页', href: '/' },
  { label: '博客', href: '/blog/' },
  { label: '项目', href: '/#projects' },
];
---

<header class="nav-mast" role="banner">
  <div class="container nav-mast-inner">
    <a href="/" class="mast-name">{SITE_CONFIG.name}</a>
    <nav class="mast-nav" aria-label="主导航">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mast-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mast-rule double" aria-hidden="true"></div>
</header>

<style>
  .nav-mast {
    background: transparent;
  }

  .nav-mast-inner {
    padding-block: var(--space-md);
    text-align: center;
  }

  .mast-name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.95;
    color: var(--color-ink);
  }

  .mast-name:hover {
    color: var(--color-accent);
  }

  .mast-nav ul {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    list-style: none;
    margin-top: var(--space-sm);
  }

  .mast-link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .mast-link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  .mast-link[data-current='true'] {
    color: var(--color-accent);
  }

  .mast-rule.double {
    border-top: var(--rule-hair) solid var(--color-rule);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    height: 4px;
  }

  @media (max-width: 480px) {
    .mast-nav ul {
      gap: var(--space-sm);
    }
  }
</style>

<script>
  const currentPath = window.location.pathname;
  document.querySelectorAll('.mast-link').forEach((link) => {
    const href = link.getAttribute('href');
    if (href && (href === currentPath || (href !== '/' && currentPath.startsWith(href)))) {
      link.setAttribute('data-current', 'true');
    }
  });
</script>
