---
import { SITE_CONFIG, SOCIAL_LINKS } from '../config';
---

<section class="hero animate-in" id="hero">
  <div class="container hero-grid">
    <img src={SITE_CONFIG.avatar} alt={SITE_CONFIG.name} class="hero-avatar" width="96" height="96" />
    <div class="hero-body">
      <h1 class="hero-title">Hi，我是 {SITE_CONFIG.name}</h1>
      <p class="hero-lead">{SITE_CONFIG.subtitle}</p>
      <div class="hero-social" aria-label="社交链接">
        {SOCIAL_LINKS.map((link) => (
          <a href={link.url} class="hero-social-link" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 96px) minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    max-width: var(--max-prose);
    margin-inline: 0;
  }

  .hero-avatar {
    width: 96px;
    height: 96px;
    border-radius: 2px;
    object-fit: cover;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .hero-lead {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
    max-width: 60ch;
  }

  .hero-social {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .hero-social-link {
    font-size: var(--text-sm);
    color: var(--color-neutral);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-social-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
