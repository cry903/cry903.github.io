---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const recentPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<section class="section container" id="blog-preview">
  <div class="section-head">
    <h2 class="section-title">最新文章</h2>
  </div>
  <div class="post-index">
    {recentPosts.map((post) => (
      <article class="post-index-item">
        <time class="post-index-date">
          {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <div class="post-index-main">
          <h3 class="post-index-title">
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
          </h3>
          {post.data.description && (
            <p class="post-index-desc">{post.data.description}</p>
          )}
        </div>
      </article>
    ))}
  </div>
  <div class="post-index-more">
    <a href="/blog/" class="text-link">查看全部博客</a>
  </div>
</section>

<style>
  .post-index {
    display: block;
  }

  .post-index-item {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-block: var(--space-md);
  }

  .post-index-date {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant: small-caps;
    letter-spacing: 0.06em;
    padding-top: 0.2em;
  }

  .post-index-title {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .post-index-title a:hover {
    color: var(--color-accent);
  }

  .post-index-desc {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .post-index-more {
    margin-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-top: var(--space-md);
  }

  .text-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: var(--text-sm);
  }

  .text-link:hover {
    color: var(--color-ink);
  }

  @media (max-width: 560px) {
    .post-index-item {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
