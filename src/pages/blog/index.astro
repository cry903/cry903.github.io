---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="博客">
  <Navbar />
  <main>
    <section class="section container">
      <div class="section-head">
        <h1 class="section-title">所有文章</h1>
      </div>
      <div class="post-index">
        {sortedPosts.map((post) => (
          <article class="post-index-item">
            <time class="post-index-date">
              {post.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <div class="post-index-main">
              <h2 class="post-index-title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="post-index-desc">{post.data.description}</p>
              )}
              {post.data.tags.length > 0 && (
                <div class="post-index-tags">
                  {post.data.tags.map((tag) => (
                    <span class="post-index-tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .post-index-item {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-block: var(--space-lg);
  }

  .post-index-date {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant: small-caps;
    letter-spacing: 0.06em;
    padding-top: 0.3em;
  }

  .post-index-title {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .post-index-title a:hover {
    color: var(--color-accent);
  }

  .post-index-desc {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    max-width: 60ch;
  }

  .post-index-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .post-index-tag {
    font-size: var(--text-xs);
    color: var(--color-neutral);
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }

  @media (max-width: 560px) {
    .post-index-item {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
